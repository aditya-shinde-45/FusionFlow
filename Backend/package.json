{
  "name": "fusionflow-backend",
  "version": "1.0.0",
  "description": "Enterprise H2R (Hire-to-Retire) HRMS Backend - Oracle Fusion Cloud HCM-inspired",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "verify:hcm": "node scripts/verify-business-processes.js",
    "verify:p2p": "node scripts/verify-p2p.js",
    "verify:mfg": "node scripts/verify-mfg.js",
    "verify:o2c": "node scripts/verify-o2c.js",
    "verify:personas": "node scripts/verify-all-personas-and-flows.js",
    "verify:all": "node scripts/verify-business-processes.js && node scripts/verify-p2p.js && node scripts/verify-mfg.js && node scripts/verify-o2c.js && node scripts/verify-all-personas-and-flows.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
